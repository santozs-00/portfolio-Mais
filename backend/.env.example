PORT=3000
# Origem(ns) do frontend permitidas no CORS (separe por vírgula)
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=troque-este-segredo

# Banco: mysql (padrão) ou sqlite (não precisa instalar nada)
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=santozs_db
DB_USER=root
DB_PASS=
# Usado só com DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite
